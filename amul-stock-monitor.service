[Unit]
Description=Amul Multi-User Stock Monitor & Auto-Checkout Platform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Desktop/Automation
ExecStart=%h/Desktop/Automation/venv/bin/python %h/Desktop/Automation/server.py
Restart=on-failure
RestartSec=30
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target