[Unit]
Description=Amul stock monitor and automatic checkout
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Desktop/Automation
ExecStart=%h/Desktop/Automation/venv/bin/python %h/Desktop/Automation/failover_manager.py
Restart=on-failure
RestartSec=15
Environment=PYTHONUNBUFFERED=1
Environment=NODE_ROLE=primary
Environment=NODE_ID=laptop

[Install]
WantedBy=default.target