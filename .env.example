# ==========================================
# Amul Auto-Checkout & Stock Monitor Config
# ==========================================

# Substore ID specific to your delivery pincode
# (See README.md on how to extract this from shop.amul.com)
AMUL_SUBSTORE_ID=66505ff5145c16635e6cc74d

# Delivery Pincode
DELIVERY_PINCODE=110001

# Target Product Settings
TARGET_PRODUCT_URL=https://shop.amul.com/en/product/amul-chocolate-whey-protein-34-g-or-pack-of-60-sachets
TARGET_PRODUCT_ALIAS=amul-chocolate-whey-protein-34-g-or-pack-of-60-sachets
TARGET_PRODUCT_SKU=WPCCP05_02

# Polling Interval in seconds (default: 60)
POLL_INTERVAL_SECONDS=60

# Telegram Bot Configuration
# Create a bot with @BotFather to get the token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Get your Chat ID from @userinfobot or @RawDataBot
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Path to exported browser cookies (JSON array format)
COOKIES_FILE=cookies.json

# Browser Headless mode: true for background, false for visible browser window
HEADLESS=true

# Quantity to purchase
PURCHASE_QUANTITY=1

# Payment Gateway Configuration
# Options: easebuzz (Recommended), phonepe, payu
PAYMENT_GATEWAY=easebuzz
# Time to wait (in seconds) for user to scan/approve payment on phone (default: 600s = 10 mins)
PAYMENT_TIMEOUT_SECONDS=600

# Purchase Timeout & Snooze Settings
# Months to pause auto-purchase after a successful order (default: 2 months)
DEFAULT_POST_PURCHASE_PAUSE_MONTHS=2
# Minimum interval (minutes) between stock alerts while paused (Notify-Only Mode)
NOTIFY_ONLY_ALERT_INTERVAL_MINUTES=30
